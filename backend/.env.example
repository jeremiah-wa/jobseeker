# ===========================================
# Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# -------------------------------------------
# Database
# -------------------------------------------
# For Docker: use db:5432
# For local development: use localhost:5432
DATABASE_URL=postgresql://jobseeker:change-me@db:5432/jobseeker

# -------------------------------------------
# Authentication
# -------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# LLM Configuration
# -------------------------------------------
# Provider options: "ollama" (local), "groq" (free API), "anthropic" (premium)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Ollama (local dev - no API costs)
# Default URL when running in Docker: http://ollama:11434
# Default URL when running locally: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# Groq (free/cheap cloud API - https://console.groq.com)
# Models: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_API_KEY=

# Anthropic (premium - https://console.anthropic.com)
# Models: claude-3-5-sonnet-20241022, claude-3-opus-20240229
ANTHROPIC_API_KEY=

# -------------------------------------------
# Job Connectors
# -------------------------------------------
# Adzuna - Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DEFAULT_COUNTRY=au

# -------------------------------------------
# Application Settings
# -------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------
# File Uploads
# -------------------------------------------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/data/uploads
