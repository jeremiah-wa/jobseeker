# Frontend Development Dockerfile
FROM node:20-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Copy package files (for initial layer caching)
COPY package.json pnpm-lock.yaml* ./

# Install dependencies at build time (cached in image)
RUN pnpm install

# Expose port
EXPOSE 3000

# Install deps again at startup (syncs volume with any package.json changes)
# Then start dev server
CMD ["sh", "-c", "pnpm install && pnpm dev"]
