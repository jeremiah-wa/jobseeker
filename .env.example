# ===========================================
# Docker Compose Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# For backend/frontend specific settings, see:
#   - backend/.env.example -> backend/.env
#   - frontend/.env.example -> frontend/.env.local

# -------------------------------------------
# PostgreSQL Database
# -------------------------------------------
POSTGRES_USER=jobseeker
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=jobseeker

# -------------------------------------------
# Backend Service (passed to container)
# -------------------------------------------
DATABASE_URL=postgresql://jobseeker:change-me-in-production@db:5432/jobseeker
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Adzuna - Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------
# Frontend Service (passed to container)
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
